# Скопируй в .env и заполни своими значениями

NODE_ENV=development
PORT=3000

# Строка подключения из Supabase: Project Settings -> Database -> Connection string (URI)
# Для Supabase обязательно DATABASE_SSL=true
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_SSL=true

# Секрет для JWT — минимум 32 случайных символа
JWT_SECRET=replace-with-at-least-32-characters-secret
JWT_EXPIRES_IN=12h

# Откуда разрешён фронтенд (dev-адрес Vite)
CORS_ORIGIN=http://localhost:5173

# Часовой пояс клуба для дневных отчётов
CLUB_TIMEZONE=Asia/Tashkent
